#!/bin/sh
# Run Herdr inside a disposable, status-line-only tmux server.
set -eu

TMUX_BIN=${HSL_TMUX_BIN:-tmux}
HERDR_BIN=${HSL_HERDR_BIN:-herdr}
SESSION_NAME=hsl
WINDOW_NAME=herdr
STDERR_REPLAY_LIMIT=20
root=$(CDPATH= cd -P "$(dirname "$0")/.." && pwd)
# Overridable for tests only: the root-table guard has to start a server
# without `unbind-key -a -T root` and show that pass-through breaks.
BASE_CONF=${HSL_TEST_BASE_CONF:-$root/tmux/base.conf}

# hsl-internal's trap died at its exec, so this file is ours to remove. Adopt it
# before the tmux check below, which exits without reaching `trap cleanup`. An
# unset value is legitimate: it means no options, exactly like an absent
# [statusline] section.
STATUS_OPTIONS=${HSL_STATUS_OPTIONS:-}
# Set before apply_status_options runs so an absent options file leaves the
# feature off rather than unset. apply_mouse_clicks reads this.
MOUSE_CLICKS=false
remove_status_options() {
    [ -n "$STATUS_OPTIONS" ] || return 0
    rm -f "$STATUS_OPTIONS"
}
trap remove_status_options EXIT HUP INT TERM

command -v "$TMUX_BIN" >/dev/null 2>&1 || {
    printf '%s\n' 'hsl: tmux is required for interactive Herdr sessions' >&2
    printf '%s\n' 'hsl: install tmux or set enabled = false' >&2
    exit 127
}

# The tmux server inherits this environment and hands it to the pane, and herdr
# refuses to start when HERDR_SESSION is set but empty. Drop it here so an
# unnamed run reaches herdr with no session name at all.
if [ -z "${HERDR_SESSION:-}" ]; then
    unset HERDR_SESSION
fi

# herdr draws with hardcoded ANSI and never opens the terminfo database, so it
# runs under any TERM. A tmux client does open it, and aborts with "missing or
# unsuitable terminal: $TERM" when the entry is absent -- routine on terminals
# newer than the installed ncurses (xterm-rio, xterm-ghostty).
term_known() {
    [ -n "$1" ] || return 1
    if command -v tput >/dev/null 2>&1; then
        tput -T "$1" longname >/dev/null 2>&1 && return 0
    fi
    if command -v infocmp >/dev/null 2>&1; then
        infocmp -- "$1" >/dev/null 2>&1 && return 0
    fi
    return 1
}

# Only a confirmed entry is ever substituted, so a host with neither tput nor
# infocmp keeps its TERM and lets tmux report the error itself.
if [ -n "${TERM:-}" ] && ! term_known "$TERM"; then
    # Quoted so a stray space or glob in the override cannot expand into extra
    # candidates.
    for candidate in "${HSL_FALLBACK_TERM:-}" xterm-256color xterm; do
        term_known "$candidate" || continue
        printf 'hsl: no terminfo entry for %s; using %s for tmux\n' \
            "$TERM" "$candidate" >&2
        TERM=$candidate
        export TERM
        break
    done
fi

umask 077
runtime=$(mktemp -d "${TMPDIR:-/tmp}/herdr-statusline.XXXXXX")
# The socket must be unique per invocation; the session name must not be,
# and must not contain a dot, or `-t` parses it as session.window.pane.
socket="hsl-$(basename "$runtime")"
conf=$runtime/tmux.conf
launcher=$runtime/launch.sh
exit_file=$runtime/exit-status
stderr_file=$runtime/stderr
args_dir=$runtime/args
mkdir "$args_dir"

cleanup() {
    "$TMUX_BIN" -L "$socket" kill-server >/dev/null 2>&1 || true
    rm -rf "$runtime"
    remove_status_options
}

# A failing herdr often prints one line and exits before it draws anything, and
# the pane is gone by the time we could read it, so replay the captured stderr.
# Successful sessions stay silent: stray output would only be terminal noise.
replay_stderr() {
    [ "$1" -ne 0 ] || return 0
    [ -s "$stderr_file" ] || return 0
    lines=$(wc -l <"$stderr_file")
    if [ "$lines" -gt "$STDERR_REPLAY_LIMIT" ]; then
        printf 'hsl: showing the last %s of %s stderr lines\n' \
            "$STDERR_REPLAY_LIMIT" "$lines" >&2
    fi
    tail -n "$STDERR_REPLAY_LIMIT" "$stderr_file" >&2
}

recorded_status() {
    [ -f "$exit_file" ] || return 1
    saved_status=$(sed -n '1p' "$exit_file")
    case $saved_status in
        ''|*[!0-9]*) return 1 ;;
    esac
    printf '%s\n' "$saved_status"
}

on_signal() {
    fallback=$1
    if final_status=$(recorded_status); then
        :
    else
        final_status=$fallback
    fi
    trap - EXIT HUP INT TERM
    cleanup
    exit "$final_status"
}

trap cleanup EXIT
trap 'on_signal 129' HUP
trap 'on_signal 130' INT
trap 'on_signal 143' TERM

QUOTE_LIB=$(CDPATH= cd -P "$(dirname "$0")" && pwd)/lib/shell-quote.sh
[ -r "$QUOTE_LIB" ] || {
    printf '%s\n' "hsl: missing shell quoting library: $QUOTE_LIB" >&2
    exit 2
}
. "$QUOTE_LIB"
# A missing or unparsable library aborts before here, but an empty or truncated
# one is sourced successfully and defines nothing, leaving every quoted value to
# expand to the empty string. Check the function, not the file.
command -v shell_quote >/dev/null 2>&1 || {
    printf '%s\n' "hsl: $QUOTE_LIB does not define shell_quote" >&2
    exit 2
}

count=0
for arg in "$HERDR_BIN" "$@"; do
    printf '%s' "$arg" >"$args_dir/$count"
    count=$((count + 1))
done
printf '%s\n' "$count" >"$args_dir/count"

{
    printf '#!/bin/sh\n'
    printf 'set -u\n'
    printf 'HSL_ARGS_DIR=%s\n' "$(shell_quote "$args_dir")"
    printf 'HSL_EXIT_FILE=%s\n' "$(shell_quote "$exit_file")"
    printf 'HSL_STDERR_FILE=%s\n' "$(shell_quote "$stderr_file")"
    printf 'HSL_TMUX_BIN=%s\n' "$(shell_quote "$TMUX_BIN")"
    cat <<'EOF_LAUNCH'
# tmux destroys the pane the instant this exits, taking any diagnostics with
# it, so keep stderr on disk for run-in-tmux to replay after the client leaves.
exec 2>"$HSL_STDERR_FILE"
set --
count=$(sed -n '1p' "$HSL_ARGS_DIR/count")
i=0
while [ "$i" -lt "$count" ]; do
    # The x sentinel survives command substitution stripping trailing newlines.
    value=$(cat "$HSL_ARGS_DIR/$i"; printf x)
    value=${value%x}
    set -- "$@" "$value"
    i=$((i + 1))
done
"$HSL_TMUX_BIN" wait-for hsl-start || exit 1
"$@"
status=$?
printf '%s\n' "$status" >"$HSL_EXIT_FILE.tmp"
mv "$HSL_EXIT_FILE.tmp" "$HSL_EXIT_FILE"
exit "$status"
EOF_LAUNCH
} >"$launcher"
chmod 700 "$launcher"

cp "$BASE_CONF" "$conf"
launcher_command="exec $(shell_quote "$launcher")"

# A pseudo terminal without a backing terminal reports "0 0"; passing that to
# tmux fails with "width too small", so every value is validated first.
size=$(stty size 2>/dev/null </dev/tty) || size=
rows=${size% *}
cols=${size#* }
case ${rows:-x} in ''|*[!0-9]*) size= ;; esac
case ${cols:-x} in ''|*[!0-9]*) size= ;; esac
if [ -n "$size" ] && { [ "$rows" -lt 3 ] || [ "$cols" -lt 10 ]; }; then
    size=
fi

(
    unset TMUX
    if [ -n "$size" ]; then
        exec "$TMUX_BIN" -L "$socket" -f "$conf" new-session -d -s "$SESSION_NAME" \
            -n "$WINDOW_NAME" -x "$cols" -y "$rows" "$launcher_command"
    else
        exec "$TMUX_BIN" -L "$socket" -f "$conf" new-session -d -s "$SESSION_NAME" \
            -n "$WINDOW_NAME" "$launcher_command"
    fi
)

set_env() {
    "$TMUX_BIN" -L "$socket" set-environment -g "$1" "$2"
}

set_env HERDR_PLUGIN_CONFIG_DIR "${HERDR_PLUGIN_CONFIG_DIR:-}"
if [ -n "${HERDR_SESSION:-}" ]; then
    set_env HERDR_SESSION "$HERDR_SESSION"
fi

# Values arrive as individual argv, never as text in $conf, so no quoting rule
# applies to them. The scope follows from the name because window-status-* are
# window options; the helper has already bounded the names to `status`,
# `status-*` and `window-status-*`.
apply_status_options() {
    [ -n "$STATUS_OPTIONS" ] || return 0
    [ -f "$STATUS_OPTIONS" ] || {
        printf '%s\n' 'hsl: invalid hsl-config output' >&2
        return 2
    }
    # Line 1 is `enabled`, already consumed by bin/hsl-internal; line 2 is
    # `mouse_clicks`; the count is line 3 and the pairs start at line 4.
    MOUSE_CLICKS=$(sed -n '2p' "$STATUS_OPTIONS") || {
        printf '%s\n' 'hsl: invalid hsl-config output' >&2
        return 2
    }
    case $MOUSE_CLICKS in
        true|false) ;;
        *)
            printf '%s\n' 'hsl: invalid hsl-config output' >&2
            return 2
            ;;
    esac
    count=$(sed -n '3p' "$STATUS_OPTIONS") || {
        printf '%s\n' 'hsl: invalid hsl-config output' >&2
        return 2
    }
    case ${count:-x} in
        ''|*[!0-9]*)
            printf '%s\n' 'hsl: invalid hsl-config output' >&2
            return 2
            ;;
    esac
    lines=$(wc -l <"$STATUS_OPTIONS") || {
        printf '%s\n' 'hsl: invalid hsl-config output' >&2
        return 2
    }
    [ "$lines" -eq $((3 + count * 2)) ] || {
        printf '%s\n' 'hsl: invalid hsl-config output' >&2
        return 2
    }
    index=0
    while [ "$index" -lt "$count" ]; do
        name=$(sed -n "$((4 + index * 2))p" "$STATUS_OPTIONS") || return 2
        # Command substitution strips the line terminator and nothing else, so
        # a value's leading and trailing spaces survive.
        value=$(sed -n "$((5 + index * 2))p" "$STATUS_OPTIONS") || return 2
        case $name in
            window-status-*) scope=-gw ;;
            *) scope=-g ;;
        esac
        if ! failure=$("$TMUX_BIN" -L "$socket" set-option "$scope" "$name" "$value" 2>&1); then
            printf 'hsl: cannot apply statusline option %s: %s\n' "$name" "$failure" >&2
            return 2
        fi
        index=$((index + 1))
    done
}

# Unlike allow-passthrough below, user ranges cannot be detected by setting
# them: tmux validates the `range` style keyword but not its value, so
# `range=user|p` is accepted on 3.3 too, where user ranges do not exist.
# Version parsing is the only test that discriminates, so it is used here and
# nowhere else. Anything unparseable counts as new enough: those are builds
# whose version string this cannot read at all, and refusing them would
# silently ignore an explicit opt-in. `next-3.9` is not such a case: the
# expression below reads 3 and 9 out of it and compares them normally.
mouse_ranges_supported() {
    version=$("$TMUX_BIN" -V 2>/dev/null) || return 0
    numbers=$(printf '%s' "$version" |
        sed -n 's/[^0-9]*\([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p') || return 0
    [ -n "$numbers" ] || return 0
    major=${numbers% *}
    minor=${numbers#* }
    [ "$major" -gt 3 ] && return 0
    [ "$major" -eq 3 ] && [ "$minor" -ge 4 ] && return 0
    return 1
}

# Status-line mouse clicks are opt-in and inert without a hook: enabling the
# mouse with nothing to dispatch to would only cost the user the terminal's
# native selection and give nothing back.
#
# Every field travels through tmux's own `#{q:...}` sh-escaper. run-shell
# format-expands the whole string before handing it to /bin/sh -c, so a range
# name is attacker-controlled text landing inside a shell command line: a
# 15-byte name is enough to break out of hand-written single quotes and run
# arbitrary code. The hook path goes the same way, as a user option, so a `#`
# in the config path cannot be re-expanded either. shell_quote is deliberately
# not used here; it escapes for a generated script, not for tmux's two-stage
# expansion.
#
# -b, the redirect and the `|| true` are three separate requirements: without
# -b the hook blocks the command queue, without the redirect its stdout is
# drawn over Herdr, and without `|| true` a non-zero exit still is.
#
# Nothing mouse-specific is touched on any early return. Ordinary status
# options are unrelated to this feature and have already been applied.
apply_mouse_clicks() {
    [ "${MOUSE_CLICKS:-false}" = true ] || return 0

    if ! mouse_ranges_supported; then
        printf '%s\n' \
            'hsl: mouse_clicks needs tmux 3.4 or newer for user ranges;' \
            'hsl: mouse clicks stay off' >&2
        return 0
    fi

    if [ -z "${HERDR_PLUGIN_CONFIG_DIR:-}" ]; then
        printf '%s\n' \
            'hsl: mouse_clicks is on but the plugin config dir is unknown;' \
            'hsl: mouse clicks stay off' >&2
        return 0
    fi

    hook=$HERDR_PLUGIN_CONFIG_DIR/on-click.sh
    if [ ! -x "$hook" ]; then
        printf 'hsl: mouse_clicks is on but %s is not executable\n' "$hook" >&2
        printf '%s\n' 'hsl: mouse clicks stay off' >&2
        return 0
    fi

    "$TMUX_BIN" -L "$socket" set-option -g @hsl_on_click "$hook" || return 2
    "$TMUX_BIN" -L "$socket" set-option -g mouse on || return 2

    for pair in \
        'MouseDown1Status left' \
        'MouseDown3Status right' \
        'WheelUpStatus wheelup' \
        'WheelDownStatus wheeldown'
    do
        key=${pair% *}
        name=${pair#* }
        "$TMUX_BIN" -L "$socket" bind-key -n "$key" run-shell -b \
            "#{q:@hsl_on_click} $name #{q:mouse_status_range} #{q:mouse_x} #{q:mouse_status_line} >/dev/null 2>&1 || true" \
            || return 2
    done
}

# A failure here must not reach herdr. The launcher is still blocked in
# `wait-for hsl-start`, so exiting takes the whole server down with it.
if ! apply_status_options; then
    exit 2
fi

if ! apply_mouse_clicks; then
    exit 2
fi

# Detect allow-passthrough by setting it, not by parsing tmux -V.
"$TMUX_BIN" -L "$socket" set-option -g allow-passthrough on >/dev/null 2>&1 || true

# `new-session` has created launch.sh, but the command is blocked in wait-for.
# Release it only after every required option and environment value is ready.
"$TMUX_BIN" -L "$socket" wait-for -S hsl-start

if (
    unset TMUX
    exec "$TMUX_BIN" -L "$socket" attach-session -t "$SESSION_NAME"
); then
    tmux_status=0
else
    tmux_status=$?
fi

if status=$(recorded_status); then
    :
else
    status=$tmux_status
fi
replay_stderr "$status"
exit "$status"
